{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "description": "Group CI updates",
      "matchManagers": ["github-actions"],
      "groupName": "CI dependencies"
    }
  ]
}
