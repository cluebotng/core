{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "description": "Group CI updates",
      "matchManagers": ["github-actions"],
      "groupName": "CI dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update cmake-buildpack release in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["https://github\\.com/InfraBits/cmake-buildpack/releases/download/(?<currentValue>[^/]+)/"],
      "depNameTemplate": "InfraBits/cmake-buildpack",
      "datasourceTemplate": "github-releases"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
